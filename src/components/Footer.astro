---
import Image from "astro/components/Image.astro";
import {
  Sun,
  CloudRain,
  CloudLightning,
  Cloud,
  CloudSun,
  XIcon,
} from "@lucide/astro";
import worldMap from "../assets/map-world.png";

// ? API CALLS
interface WeatherData {
  main: { temp: number };
  weather: Array<{
    id: number;
    main: string;
    description: string;
    icon: string;
  }>;
}

const WEATHER_API = import.meta.env.WEATHER_API_KEY;
const WEATHER_URL = "https://api.openweathermap.org/data/2.5/weather";

async function getWeather(city: string): Promise<WeatherData | null> {
  try {
    const response = await fetch(
      `${WEATHER_URL}?q=${city}&appid=${WEATHER_API}&units=metric`,
    );
    if (!response.ok) return null;
    return await response.json();
  } catch (e) {
    return null;
  }
}

const kyotoData = await getWeather("Kyoto");
const vancouverData = await getWeather("Vancouver");

const getWeatherIcon = (id: number) => {
  if (id >= 200 && id < 300) return CloudLightning;
  if (id >= 300 && id < 600) return CloudRain;
  if (id === 800) return Sun;
  if (id > 800 && id <= 802) return CloudSun;
  if (id === 404) return XIcon;
  return Cloud;
};
const getWeatherClass = (id: number) => {
  if (id >= 200 && id < 300) return "animate-lightning";
  if (id >= 300 && id < 600) return "animate-rain";
  if (id === 800) return "animate-sun";
  if (id > 800 && id <= 802) return "animate-cloud";
  if (id === 404) return "XIcon";
  return "animate-cloud";
};

const SaIcon = getWeatherIcon(kyotoData?.weather[0]?.id ?? 404);
const KuIcon = getWeatherIcon(vancouverData?.weather[0]?.id ?? 404);

const saWeatherClass = getWeatherClass(kyotoData?.weather[0]?.id ?? 404);
const kuWeatherClass = getWeatherClass(vancouverData?.weather[0]?.id ?? 404);

// ? Class names
const nameWeatherContainer = "flex w-full gap-8 items-center justify-around";
const headerLocation =
  "font-light noto-sans-jp text-ku-brown text-3xl tracking-wide";
const locationText = "text-base font-medium text-neutral-600";
const timeContainer = "flex flex-col items-center mt-2";
const hourText =
  "text-5xl text-neutral-600 roboto-mono font-light tracking-wider";
const dateText =
  "text-lg text-neutral-600 noto-sans-jp -mt-0.5 ml-4 tracking-widest";
  const tempText = "text-neutral-600 tracking-wide";
---

<footer
  class="border-t border-neutral-200 py-6 flex flex-col items-center justify-center bg-transparent"
>
  <div
    id="geographic-information"
    class="flex flex-col lg:flex-row w-full items-center justify-around gap-12 mb-6 px-5"
  >
    <!-- > Sa -->
    <div id="sa-geographic" class="w-full md:w-1/4">
      <!-- ? Who and weather -->
      <div class={nameWeatherContainer}>
        <div>
          <h3 class={headerLocation}>Sa-chan's location</h3>
          <p class={locationText}>Kyoto, Japan</p>
        </div>
        <!-- ? Weather Icon -->
        <div>
          <SaIcon
            class=`text-ku-brown ${saWeatherClass}`
            stroke-width={1}
            size={42}
          />
          <p class={tempText}>
            {kyotoData?.main?.temp?.toFixed(1)}°
          </p>
        </div>
      </div>
      <!-- ? Time -->
      <div class={timeContainer}>
        <!-- ? Hour -->
        <p class={hourText} id="sa-clock">00:00:00</p>
        <!-- ? Date -->
        <p class={dateText} id="sa-date">Date</p>
      </div>
    </div>
    <!-- > Map -->
      <!-- TODO  fix responsiveness -->
    <div
      id="map-container"
      class="hidden md:inline-block relative w-1/3 h-54 bg-transparent rounded-2xl overflow-hidden border-2 border-neutral-300 shadow"
    >
      <div id="map" class="absolute w inset-0 z-0 rounded-xl">
        <Image
          src={worldMap}
          alt="World Map"
          class="w-full h-full object-cover"
        />
      </div>

      <svg
        viewBox="0 0 800 400"
        class="relative z-10 w-full h-full pointer-events-none"
      >
        <path
          d="M 203,200 Q 400,50 703,125"
          fill="none"
          stroke="#2D2926"
          stroke-width="4"
          stroke-dasharray="5 ,5 "
          class="animate-draw-line"></path>

        <circle cx="203" cy="200" r="4" fill="#2D2926">
          <animate
            attributeName="r"
            values="4;6;4"
            dur="2s"
            repeatCount="indefinite"></animate>
        </circle>

        <circle cx="703" cy="125" r="4" fill="#2D2926">
          <animate
            attributeName="r"
            values="4;6;4"
            dur="2s"
            repeatCount="indefinite"></animate>
        </circle>
      </svg>
    </div>
    <!-- > Ku -->
    <div id="ku-geographic" class="w-full md:w-1/4">
      <!-- ? Who and weather -->
      <div class={`${nameWeatherContainer} md:text-end flex-row-reverse md:flex-row`}>
        <!-- ? Weather Icon -->
        <div>
          <KuIcon
            class=`text-ku-brown ${kuWeatherClass}`
            stroke-width={1}
            size={42}
          />
          <p class={tempText}>{vancouverData?.main?.temp?.toFixed(1)}°</p>
        </div>
        <div>
          <h3 class={headerLocation}>Ku-chan's location</h3>
          <p class={locationText}>Vancouver, Canada</p>
        </div>
      </div>
      <!-- ? Time -->
      <div class={timeContainer}>
        <!-- ? Hour -->
        <p id="ku-clock" class={hourText}>--> 00:00:00</p>
        <!-- ? Date -->
        <p class={dateText} id="ku-date">Date</p>
      </div>
    </div>
  </div>
  <quote class="px-6 noto-serif-jp text-center text-md italic text-black-ink border-l-3 rounded-xs border-ku-brown pl-2">
    "Distance is nothing with the type of love we have. We are always together,
    no matter where we are."
  </quote>
  <p class="px-6 text-md text-black-ink noto-sans-jp font-light">
    Done with <span class="animate-heartbeat">❤️</span> by Ku-chan for Sa-chan — &copy;{new Date().getFullYear()}
  </p>
</footer>

<script>
  import $ from "jquery";

  function updateClocks() {
    const now = new Date();

    const kyotoTime = now.toLocaleTimeString("es-ES", {
      timeZone: "Asia/Tokyo",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    });

    const vancouverTime = now.toLocaleTimeString("es-ES", {
      timeZone: "America/Vancouver",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    });

    // Inyección con sintaxis jQuery
    $("#sa-clock").text(kyotoTime);
    $("#ku-clock").text(vancouverTime);
  }

  function updateDates() {
    const now = new Date();

    const kyotoDate = now.toLocaleDateString("jp-EN", {
      timeZone: "Asia/Tokyo",
      weekday: "long",
      day: "numeric",
      month: "long",
    });

    const vancouverDate = now.toLocaleDateString("en-EN", {
      timeZone: "America/Vancouver",
      weekday: "long",
      day: "numeric",
      month: "long",
    });

    // Inyección con sintaxis jQuery
    $("#sa-date").text(kyotoDate);
    $("#ku-date").text(vancouverDate);
  }

  // Inicializar y configurar el intervalo
  $(document).ready(function () {
    updateClocks();
    updateDates();
    setInterval(updateClocks, 1000);
  });
</script>
