---
import { Image } from "astro:assets";
import logo from "../../public/logo.webp";
import { Heart } from "@lucide/astro";
import "../styles/global.css";

const buttonStyle =
  "flex flex-col gap-3 items-center align-middle w-55 py-5 rounded-3xl bg-transparent border-2 border-[#E5E5E5] group";
const buttonHoverStyle =
  "hover:bg-[#f3f3f2] hover:cursor-pointer hover:-translate-y-1.5 transition-all ease-in-out duration-300";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter...&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Natsu Ni Aou</title>
  </head>
  <body
    class="bg-[#F8F8F3] flex flex-col items-center justify-center min-h-screen"
  >
    <figure>
      <Image src={logo} alt="Hero Image" class="w-65 h-auto object-cover" />
      <h1
        class="text-center noto-serif-jp text-4xl font-medium text-[#805C5C] mt-10"
      >
        Natsu Ni Aou
      </h1>
    </figure>
    <h2
      id="question-login"
      class="text-center mt-4 noto-sans-jp font-normal text-lg text-[#805C5C]"
    >
      Before crossing the bridge, tell me... who has arrived today?
    </h2>
    <div id="who-is-btns" class="flex items-center gap-6 mt-6">
      <button id="sa-btn" class={`${buttonStyle} ${buttonHoverStyle} user-btn`}
        ><span
          id="sakura-emoji"
          class="text-center text-4xl group-hover:scale-110 transition-all"
          >🌸</span
        ><span class="noto-sans-jp text-[#C48B91]">I'm Sa-chan</span></button
      >
      <Heart color="#805C5C" fill="#805C5C" size={48} stroke-width={1} />
      <button id="ku-btn" class={`${buttonStyle} ${buttonHoverStyle} user-btn`}
        ><span
          id="ku-emoji"
          class="text-center text-4xl group-hover:scale-110 transition-all"
          >🐻</span
        ><span class="noto-sans-jp text-[#805C5C]">I'm Ku-chan</span></button
      >
    </div>
    <div
      id="secret-password-container"
      class="flex flex-col w-115 align-middle items-center mt-8 transition-all duration-700 ease-in-out opacity-0 translate-y-4 pointer-events-none"
    >
      <h3 class="font-normal noto-sans-jp text-[#805C5C] text-lg">
        Our secret answer...
      </h3>
      <input
        type="password"
        name="secret"
        id="secret-password-inp"
        class="border-2 border-[#E5E5E5] w-full rounded-lg py-3 mt-4 text-center text-[#805C5C] outline-[#E5E5E5] tracking-[0.5em]"
        placeholder="•••••••••••••••"
      />
      <button
        type="submit"
        id="enter-world-btn"
        class="w-full py-3 rounded-xl noto-serif-jp text-lg mt-6 border-2 text-[#805C5C] border-[#E5E5E5] bg-transparent hover:bg-[#F3F6C7] hover:border-[#F3F6C7] shadow hover:cursor-pointer hover:scale-105 transition-all hover:font-semibold ease-in-out duration-300"
        >Enter our world</button
      >
    <!-- <p>A place where time stands still for us</p> -->
    </div>
  </body>
  <script>
    import $ from "jquery";
    let selectedUser: string = '';
    let secretPassword: string = '';

    $(document).ready(function () {
      const saBtn = $("#sa-btn");
      const kuBtn = $("#ku-btn");
      const saEmoji = $("#sakura-emoji");
      const kuEmoji = $("#ku-emoji");

      const secretPasswordInput = $("#secret-password-inp");
      const enterWorldBtn = $("#enter-world-btn");

      // ? Styles
      const saActive =
        "!bg-[#F6D9DB] !-translate-y-1.5 !border-[#F6D9DB] shadow";
      const kuActive =
        "!bg-[#B7958B] !-translate-y-1.5 !border-[#B7958B] shadow";

      $(".user-btn").click(function () {
        saBtn.removeClass(saActive);
        kuBtn.removeClass(kuActive);
        saEmoji.removeClass("scale-110 sakura-rotation");
        kuEmoji.removeClass("scale-110 ku-dance");

        if (this.id === "sa-btn") {
          selectedUser = "sa";
          $(this).addClass(saActive);
          saEmoji.addClass("scale-110 sakura-rotation");
        } else {
          selectedUser = "ku";
          $(this).addClass(kuActive);
          kuEmoji.addClass("scale-110 ku-dance");
        }

        // Appear secret password input
        $("#secret-password-container")
          .removeClass("opacity-0 translate-y-4 pointer-events-none")
          .addClass("opacity-100 translate-y-0 pointer-events-auto");
      });

      $("#enter-world-btn").click(function () {
        secretPassword = $("#secret-password-inp").val();

        if (secretPassword === "123") {
          alert(
            "Welcome, " +
              (selectedUser === "sa" ? "Sa-chan" : "Ku-chan") +
              "! ✨",
          );
          window.location.href = "/home";
        } else {
          alert("Esa no es nuestra respuesta secreta... 🌸🐻");
        }
      });
    });
  </script>
</html>
