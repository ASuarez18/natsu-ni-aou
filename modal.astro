const showModal = (msg, emoji, callback) => {
  $("#modal-message").text(msg);
  $("#modal-icon").text(emoji);
  $("#custom-modal").removeClass("hidden").addClass("flex");
  
  // Esperamos 2 segundos y ejecutamos la acción (como redirigir)
  setTimeout(() => {
    $("#custom-modal").addClass("hidden");
    if (callback) callback();
  }, 2000);
};

